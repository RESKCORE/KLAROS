# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_key_here"

# Clerk Redirect URLs
VITE_CLERK_SIGN_IN_URL="/login"
VITE_CLERK_SIGN_UP_URL="/signup"
VITE_CLERK_AFTER_SIGN_IN_URL="/dashboard"
VITE_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ─── Application URL ──────────────────────────────────────────────────────────
VITE_APP_URL="https://your-domain.vercel.app"

# ─── Supabase (client-side, safe to expose) ───────────────────────────────────
# Get from: https://supabase.com → Project → Settings → API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ─── LLM Proxy Toggle (development only) ─────────────────────────────────────
# Set to "true" when running `vercel dev` locally to enable the /api/llm proxy.
# In production (Vercel), the proxy is always active — leave unset.
VITE_USE_LLM_PROXY="false"

# ═══════════════════════════════════════════════════════════════════════════════
# ⚠️  SERVER-SIDE SECRETS — Set these in Vercel Dashboard → Environment Variables
#     DO NOT prefix with VITE_ — they must NEVER appear in the browser bundle.
# ═══════════════════════════════════════════════════════════════════════════════
#
# These are shown here only as documentation for what to set in Vercel.
# Never put real values in this file and never commit them to git.
#
# ─── LLM API Keys (server-side only) ─────────────────────────────────────────
# Priority chain: Groq (fastest) → OpenRouter (variety) → Gemini (fallback)
#
# GROQ_API_KEY="gsk_your_groq_key"
#   Sign up: https://console.groq.com/keys
#
# OPENROUTER_API_KEY="sk-or-your-openrouter-key"
#   Sign up: https://openrouter.ai/keys
#
# GEMINI_API_KEY="AIzaSy_your_gemini_key"
#   Get key: https://ai.google.dev
#
# ─── Clerk Server Secret (for JWT verification in api/llm.ts) ────────────────
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
#   Get from: Clerk Dashboard → API Keys → "JWT Public Key" (PEM format)
#   Used by api/llm.ts to verify that only authenticated users call the LLM proxy.
