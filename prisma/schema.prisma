generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DecisionStatus {
  draft
  analyzing
  done
  archived
}

enum ConstraintType {
  budget
  timeline
  risk
  other
}

enum DataSourceType {
  supermarket_products
  google_sheets
  csv
}

enum DataSourceStatus {
  connected
  syncing
  error
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  clerkUserId  String       @unique
  email        String?
  fullName     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  decisions    Decision[]
  dataSources  DataSource[]
}

model Decision {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  context       String?
  status        DecisionStatus
  dataSourceId  String?       @db.Uuid
  decisionType  String?
  resultJson    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String?       @db.Uuid

  user          User?         @relation(fields: [userId], references: [id])
  dataSource    DataSource?   @relation(fields: [dataSourceId], references: [id])
  options       Option[]
  criteria      Criterion[]
  constraints   Constraint[]

  @@index([userId])
  @@index([dataSourceId])
  @@index([status])
}

model Option {
  id          String     @id @default(uuid()) @db.Uuid
  decisionId  String     @db.Uuid
  label       String
  notes       String?
  description String?

  decision    Decision   @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  scores      Score[]

  @@index([decisionId])
}

model Criterion {
  id          String     @id @default(uuid()) @db.Uuid
  decisionId  String     @db.Uuid
  name        String
  weight      Float
  description String?
  rationale   String?

  decision    Decision   @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  scores      Score[]

  @@index([decisionId])
}

model Constraint {
  id          String          @id @default(uuid()) @db.Uuid
  decisionId  String          @db.Uuid
  type        ConstraintType
  value       String
  priority    Int?
  description String?

  decision    Decision        @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
}

model Score {
  id           String     @id @default(uuid()) @db.Uuid
  optionId     String     @db.Uuid
  criterionId  String     @db.Uuid
  score        Float
  notes        String?

  option       Option     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  criterion    Criterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([optionId])
  @@index([criterionId])
  @@index([optionId, criterionId])
}

model DataSource {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  name              String
  type              DataSourceType
  connectionDetails Json?
  lastSyncedAt      DateTime?
  status            DataSourceStatus @default(connected)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User             @relation(fields: [userId], references: [id])
  decisions         Decision[]
  products          SupermarketProduct[]
  salesHistory      SalesHistory[]
  stockMovements    StockMovement[]
  purchases         Purchase[]
  investments       Investment[]

  @@index([userId])
  @@index([userId, type])
}

model SupermarketProduct {
  id           String       @id @default(uuid()) @db.Uuid
  dataSourceId String       @db.Uuid
  productId    String
  name         String
  category     String
  subcategory  String?
  brand        String?
  price        Float
  costPrice    Float?
  unit         String
  description  String?

  dataSource   DataSource   @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  sales        SalesHistory[]
  stock        StockMovement[]
  purchases    Purchase[]

  @@index([dataSourceId])
  @@index([category])
  @@index([name])
}

model SalesHistory {
  id               String              @id @default(uuid()) @db.Uuid
  dataSourceId     String              @db.Uuid
  productId        String?             @db.Uuid
  externalProductId String?
  saleDate         DateTime
  quantitySold     Float
  revenue          Float
  discount         Float?
  customerSegment  String?

  dataSource       DataSource          @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  product          SupermarketProduct? @relation(fields: [productId], references: [id])

  @@index([dataSourceId])
  @@index([productId, saleDate])
  @@index([saleDate])
}

model StockMovement {
  id               String              @id @default(uuid()) @db.Uuid
  dataSourceId     String              @db.Uuid
  productId        String              @db.Uuid
  currentStock     Float
  lastUpdated      DateTime
  minStockThreshold Float?
  movementType     String?

  dataSource       DataSource          @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  product          SupermarketProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([dataSourceId, productId])
}

model Purchase {
  id            String              @id @default(uuid()) @db.Uuid
  dataSourceId  String              @db.Uuid
  supplierName  String
  productId     String?             @db.Uuid
  purchaseDate  DateTime
  quantity      Float
  unitCost      Float
  totalCost     Float?
  invoiceId     String?

  dataSource    DataSource          @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  product       SupermarketProduct? @relation(fields: [productId], references: [id])

  @@index([dataSourceId])
  @@index([supplierName])
  @@index([purchaseDate])
}

model Investment {
  id            String     @id @default(uuid()) @db.Uuid
  dataSourceId  String     @db.Uuid
  date          DateTime?
  amount        Float
  category      String?
  description   String?
  expectedRoi   Float?
  actualRoi     Float?

  dataSource    DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([dataSourceId])
  @@index([date])
}
